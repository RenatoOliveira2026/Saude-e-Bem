{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/payments/cron/subscriptions",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/payments/cron/reconcile-pending",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/whatsapp-automation",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/automation",
      "schedule": "0 8 * * *"
    }
  ]
}
